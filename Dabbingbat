<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dabbingbat Games</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #121214;
            color: #ffffff;
            margin: 0;
            padding: 0;
            text-align: center;
        }
        header {
            background-color: #1f1f23;
            padding: 40px 20px;
            border-bottom: 3px solid #8c52ff;
        }
        h1 {
            margin: 0;
            font-size: 3rem;
            color: #8c52ff;
            text-shadow: 0 0 10px rgba(140, 82, 255, 0.5);
        }
        p.subtitle {
            font-size: 1.2rem;
            color: #a1a1aa;
            margin-top: 100px;
        }
        .container {
            max-width: 800px;
            margin: 40px auto;
            padding: 0 20px;
        }
        .game-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }
        .game-card {
            background-color: #1f1f23;
            border: 1px solid #2d2d34;
            border-radius: 12px;
            padding: 30px;
            transition: transform 0.2s, border-color 0.2s;
            cursor: pointer;
            text-decoration: none;
            color: white;
            display: block;
        }
        .game-card:hover {
            transform: translateY(-5px);
            border-color: #8c52ff;
        }
        .game-card h3 {
            margin: 0 0 100px 0;
            color: #ffffff;
        }
        .game-card p {
            color: #a1a1aa;
            margin: 0;
            font-size: 0.9rem;
        }
        footer {
            margin-top: 60px;
            padding: 20px;
            color: #71717a;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>

    <header>
        <h1>Dabbingbat Games</h1>
        <p class="subtitle">Free games with no ads.. yet ;)</p>
    </header>

    <div class="container">
        <h2>Mine Spill</h2>
        <div class="game-grid">
            
            <!-- Her legger vi til spillkort etter hvert -->
            <a href="#" class="game-card">
                <h3>Computer Games</h3>
                <p>Klikk her for å se mine PC-spill.</p>
            </a>

            <a href="#" class="game-card">
                <h3>Kommentarer</h3>
                <p>Se kommentarer og signaturer.</p>
            </a>

        </div>
    </div>

    <footer>
        &copy; 2026 Dabbingbat Games
    </footer>

</body>
</html>
